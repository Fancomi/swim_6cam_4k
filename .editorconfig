root = true

# .bat must be UTF-8 without BOM: cmd.exe treats a BOM as part of the first
# command. See AGENTS.md "Windows bat 脚本编码规范".
[*.bat]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.ps1]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.{cpp,hpp,h,mm,metal,hlsl,glsl}]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true

[*.py]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true

[*.sh]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{md,json,conf,txt,cmake}]
charset = utf-8
insert_final_newline = true
