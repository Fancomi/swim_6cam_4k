# Local environment and OS metadata
.DS_Store
.venv
.worktrees/
.superpowers/
/build/

# Python caches
__pycache__/
*.py[cod]

# Large/generated render artifacts
outputs/videos/*
!outputs/videos/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep
outputs/data/*.fbx
outputs/keypoint_preview/

# Compiled runtime assets are reproducible build outputs
assets/generated/*.swasset

# Benchmark runs are local machine evidence; keep only the directory anchor.
benchmarks/*
!benchmarks/.gitkeep
