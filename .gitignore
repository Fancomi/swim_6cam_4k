# Local environment and OS metadata
.DS_Store
.venv
# install.bat renames a wrong-version .venv aside instead of deleting it
.venv.bak-*
.worktrees/
.superpowers/
.pytest_cache/
build/
outputs/

# Python caches
__pycache__/
*.py[cod]

# Calibration inputs are NOT in this repository — not the models, not the
# textures, not one committed fixture. They were purged from history on
# 2026-08-17: 225MB of pool photography that a 25MB source tree should not carry,
# and versioning them here would have meant a second copy per FBX revision.
# They travel out of band (see docs/DATA.md) and land in this tree by hand.
#
# Ignore everything under inputs/ except the runtime configs, which are small,
# hand-maintained, and belong with the code that reads them. python.stitch
# regenerates <line>_<backend>.conf per machine and clip directory, so only the
# two hand-written reference configs are named back in.
inputs/*
!inputs/configs/
inputs/configs/*
!inputs/configs/macos_*.conf
!inputs/configs/windows_*.conf

# Prebuilt CUDA/GL backend deps (FFmpeg+cuvid, GLFW) — large binaries, fetched
# locally by install.bat. downloads/ is its installer/zip cache (already covered
# by the line above, spelled out so its purpose is obvious).
/third_party/
/third_party/downloads/

# Agent worktrees and downloaded model weights are local scratch
.claude/worktrees/
*.pt

# The FBX SDK drops .mayaSwatches/ caches beside any model it reads. Everything
# under inputs/ is already ignored; this catches a model opened elsewhere.
**/.mayaSwatches/
