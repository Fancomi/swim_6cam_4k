# Local environment and OS metadata
.DS_Store
.venv
# install.bat renames a wrong-version .venv aside instead of deleting it
.venv.bak-*
.worktrees/
.superpowers/
.pytest_cache/
build/
outputs/

# Python caches
__pycache__/
*.py[cod]

# Controlled inputs that are local-only (heavy FBX assets, not the committed
# pool fixture already tracked at inputs/pool/models/pool.fbx).
inputs/underwater/models/
inputs/overhead/models/
inputs/pool/models/*.fbx
# The overlay's water_entry2 models and the overhead lane diagram are the same
# kind of local drop, but they land beside committed fixtures rather than in a
# directory of their own, so they need naming: ignore every FBX here and let
# the two tracked ones (005/006, the old single-mesh regression path) back in.
inputs/water_entry/models/*.fbx
!inputs/water_entry/models/005.fbx
!inputs/water_entry/models/006.fbx
inputs/overhead/*.png

# Prebuilt CUDA/GL backend deps (FFmpeg+cuvid, GLFW) — large binaries, fetched
# locally by install.bat. downloads/ is its installer/zip cache (already covered
# by the line above, spelled out so its purpose is obvious).
/third_party/
/third_party/downloads/

# Agent worktrees and downloaded model weights are local scratch
.claude/worktrees/
*.pt
# Runtime configs python.stitch regenerates per machine and per clip directory.
# The committed ones (macos_*, windows_*) are hand-maintained references.
inputs/configs/pool_*.conf
inputs/configs/underwater_*.conf
inputs/configs/overhead_*.conf
# Loose model drops straight into inputs/ (before they are filed under a line)
inputs/*.fbx
inputs/*.fbm/

# FBX 配套纹理目录（任意深度）是本地大资产，不提交；FBX SDK 还会在
# 旁边生成 .mayaSwatches/ 缓存，一并忽略。
**/*.fbm/
**/.mayaSwatches/
